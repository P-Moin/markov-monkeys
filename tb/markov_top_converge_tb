`timescale 1ns/1ps

module markov_top_converge_tb;

  // Parameters (must match DUT instantiation)
  parameter N       = 8;
  parameter DW      = 8;
  parameter ACC_W   = 32;
  parameter CYC_W   = 16;
  parameter FRAC_W  = 8;
  localparam CNT_W  = (N <= 1) ? 1 : $clog2(N);

  localparam TIMEOUT_CYCLES = 5000;

  // DUT signals
  reg clk;
  reg rst_n;
  reg start;
  reg [CYC_W-1:0] max_cycles;
  reg [ACC_W-1:0] tolerance;
  
  wire chain_done;
  wire converged;
  
  reg signed [N*N*DW-1:0] probability_matrix;
  reg signed [N*DW-1:0]   initial_vector;
  reg  [CNT_W-1:0] rd_vec_addr;
  wire signed [ACC_W-1:0] rd_vec_data;

  integer errors;
  integer checks;
  integer tests_run;

  integer i, j, k, r;
  
  // Test data arrays
  reg signed [DW-1:0]    mat_a     [0:N-1][0:N-1];
  reg signed [DW-1:0]    init_vec  [0:N-1];
  reg signed [DW-1:0]    cur_vec   [0:N-1];
  reg signed [ACC_W-1:0] gold_raw  [0:N-1];
  reg signed [ACC_W-1:0] final_raw [0:N-1];
  reg signed [ACC_W-1:0] prev_raw  [0:N-1]; 
  
  reg signed [ACC_W-1:0] dut_vec   [0:N-1];

  // DUT instantiation (FIXED: Module name matches markov_top_converge)
  markov_top_converge #(
    .N(N), .DW(DW), .ACC_W(ACC_W), .CYC_W(CYC_W), .FRAC_W(FRAC_W)
  ) dut (
    .clk(clk), .rst_n(rst_n),
    .start(start), 
    .max_cycles(max_cycles),
    .tolerance(tolerance),
    .chain_done(chain_done),
    .converged(converged),
    .probability_matrix(probability_matrix),
    .initial_vector(initial_vector),
    .rd_vec_addr(rd_vec_addr), 
    .rd_vec_data(rd_vec_data)
  );

  // Clock
  initial clk = 1'b0;
  always #5 clk = ~clk;

  // Reset task
  task reset_dut;
    begin
      rst_n               = 1'b0;
      start               = 1'b0;
      max_cycles          = {CYC_W{1'b0}};
      tolerance           = {ACC_W{1'b0}};
      probability_matrix  = {(N*N*DW){1'b0}};
      initial_vector      = {(N*DW){1'b0}};
      rd_vec_addr         = {CNT_W{1'b0}};
      
      repeat (5) @(posedge clk);
      rst_n = 1'b1;
      repeat (2) @(posedge clk);
      
      if (chain_done !== 1'b0) begin
        $display("ERROR: [reset_dut] chain_done not idle after reset (chain_done=%b)", chain_done);
        errors = errors + 1;
      end
    end
  endtask

  // Wait for chain_done with timeout guard
  task wait_for_chain_done;
    integer timeout_cnt;
    begin
      timeout_cnt = 0;
      while ((chain_done !== 1'b1) && (timeout_cnt < TIMEOUT_CYCLES)) begin
        @(posedge clk);
        timeout_cnt = timeout_cnt + 1;
      end
      if (chain_done !== 1'b1) begin
        $display("ERROR: [wait_for_chain_done] TIMEOUT after %0d cycles", TIMEOUT_CYCLES);
        errors = errors + 1;
      end
    end
  endtask

  // Pack matrix and vector data onto buses
  task pack_matrix_to_bus;
    begin
      for (i = 0; i < N; i = i + 1) begin
        for (j = 0; j < N; j = j + 1) begin
          probability_matrix[(i*N + j)*DW +: DW] = mat_a[i][j];
        end
      end
    end
  endtask

  task pack_vector_to_bus;
    begin
      for (k = 0; k < N; k = k + 1) begin
        initial_vector[k*DW +: DW] = init_vec[k];
      end
    end
  endtask

  // Read full state vector out of DUT (FIXED: Clock edge alignment for synchronous RAM read)
  task read_state_vector;
    begin
      for (k = 0; k < N; k = k + 1) begin
        rd_vec_addr = k[CNT_W-1:0];
        @(posedge clk);
        #1;
        dut_vec[k] = rd_vec_data;
      end
    end
  endtask

  // One matrix multiplication pass
  task golden_multiply;
    integer gj, gk;
    integer acc;
    begin
      for (gj = 0; gj < N; gj = gj + 1) begin
        acc = 0;
        for (gk = 0; gk < N; gk = gk + 1) begin
          acc = acc + (cur_vec[gk] * mat_a[gk][gj]);
        end
        gold_raw[gj] = acc;
      end
    end
  endtask

  // Compare output vector against golden model
  task compare_vec;
    input integer test_id;
    begin
      for (k = 0; k < N; k = k + 1) begin
        checks = checks + 1;
        if (dut_vec[k] !== final_raw[k]) begin
          $display("ERROR: test %0d elem %0d MISMATCH: dut=%0d gold=%0d",
                    test_id, k, $signed(dut_vec[k]), $signed(final_raw[k]));
          errors = errors + 1;
        end
      end
    end
  endtask

  // Full execution driver
  task run_markov_test;
    input integer num_iters_req;
    input integer test_tolerance;
    input integer test_id;
    
    integer eff_iters;
    reg expected_converged;
    reg tol_exceeded;
    
    reg signed [ACC_W:0] diff;
    reg [ACC_W:0] abs_diff;
    
    begin
      tests_run = tests_run + 1;
      $display("---- Running test %0d (max_cycles=%0d, tol=%0d) ----", test_id, num_iters_req, test_tolerance);

      reset_dut;
      pack_matrix_to_bus;
      pack_vector_to_bus;

      @(posedge clk);
      start      = 1'b1;
      max_cycles = num_iters_req[CYC_W-1:0];
      tolerance  = test_tolerance[ACC_W-1:0];
      @(posedge clk);
      start = 1'b0;

      wait_for_chain_done;

      eff_iters = (num_iters_req == 0) ? 1 : num_iters_req;
      expected_converged = 1'b0;

      for (k = 0; k < N; k = k + 1) cur_vec[k] = init_vec[k];

      // Golden Convergence Model
      for (r = 1; (r <= eff_iters) && !expected_converged; r = r + 1) begin
        golden_multiply;

        if (r >= 2) begin
          tol_exceeded = 1'b0;
          for (k = 0; k < N; k = k + 1) begin
            diff = $signed({gold_raw[k][ACC_W-1], gold_raw[k]}) - $signed({prev_raw[k][ACC_W-1], prev_raw[k]});
            abs_diff = (diff < 0) ? -diff : diff;
            
            if (abs_diff > test_tolerance) begin
              tol_exceeded = 1'b1;
            end
          end
          
          if (!tol_exceeded) begin
            expected_converged = 1'b1;
          end
        end

        for (k = 0; k < N; k = k + 1) begin
          prev_raw[k]  = gold_raw[k];
          final_raw[k] = gold_raw[k];
          cur_vec[k]   = gold_raw[k][DW-1:0]; // Slice feedback
        end
      end

      read_state_vector;
      compare_vec(test_id);
      
      checks = checks + 1;
      if (converged !== expected_converged) begin
         $display("ERROR: test %0d CONVERGENCE MISMATCH: dut=%b gold=%b", test_id, converged, expected_converged);
         errors = errors + 1;
      end

      $display("---- Finished test %0d ----", test_id);
    end
  endtask

  // Random INT8 generator helper
  function integer rand_int8;
    input integer dummy;
    integer rv;
    begin
      rv = $random % 256;
      if (rv < 0) rv = rv + 256;
      rand_int8 = rv - 128;
    end
  endfunction

  task rand_matrix;
    begin
      for (i = 0; i < N; i = i + 1)
        for (j = 0; j < N; j = j + 1)
          mat_a[i][j] = rand_int8(0);
    end
  endtask

  task rand_vector;
    begin
      for (k = 0; k < N; k = k + 1)
        init_vec[k] = rand_int8(0);
    end
  endtask

  // Main Test Stimulus
  integer t;
  integer n_iters;
  
  initial begin
    errors     = 0;
    checks     = 0;
    tests_run  = 0;
    rst_n      = 1'b0;
    start      = 1'b0;
    max_cycles = {CYC_W{1'b0}};
    tolerance  = {ACC_W{1'b0}};

    // T1: Identity matrix, 1 iteration
    for (i = 0; i < N; i = i + 1)
      for (j = 0; j < N; j = j + 1)
        mat_a[i][j] = (i == j) ? 8'sd100 : 8'sd0;
    for (k = 0; k < N; k = k + 1) init_vec[k] = 8'sd40 + k;
    run_markov_test(1, 0, 1);

    // T2: 2-state block
    for (i = 0; i < N; i = i + 1)
      for (j = 0; j < N; j = j + 1)
        mat_a[i][j] = 8'sd0;
    mat_a[2][2] = 8'sd90;  mat_a[2][3] = 8'sd38;
    mat_a[3][2] = 8'sd38;  mat_a[3][3] = 8'sd90;
    for (k = 0; k < N; k = k + 1) init_vec[k] = 8'sd0;
    init_vec[2] = 8'sd127; init_vec[3] = -8'sd128;
    run_markov_test(3, 0, 2);

    // T3: All-zero matrix (forces exact convergence on pass 2)
    for (i = 0; i < N; i = i + 1)
      for (j = 0; j < N; j = j + 1)
        mat_a[i][j] = 8'sd0;
    for (k = 0; k < N; k = k + 1) init_vec[k] = 8'sd77 - k;
    run_markov_test(5, 0, 3);

    // T4: Max-magnitude values
    for (i = 0; i < N; i = i + 1)
      for (j = 0; j < N; j = j + 1)
        mat_a[i][j] = 8'sd127;
    for (k = 0; k < N; k = k + 1) init_vec[k] = 8'sd127;
    run_markov_test(2, 0, 4);

    // T5: Zero max cycles (defaults to 1 pass)
    for (i = 0; i < N; i = i + 1)
      for (j = 0; j < N; j = j + 1)
        mat_a[i][j] = (i == j) ? 8'sd64 : 8'sd10;
    for (k = 0; k < N; k = k + 1) init_vec[k] = 8'sd5 * k;
    run_markov_test(0, 0, 5);
    
    // T6: Convergence threshold verification
    for (i = 0; i < N; i = i + 1)
      for (j = 0; j < N; j = j + 1)
        mat_a[i][j] = 8'sd0;
    mat_a[0][0] = 8'sd2;
    for (k = 0; k < N; k = k + 1) init_vec[k] = 8'sd0;
    init_vec[0] = 8'sd5;
    run_markov_test(10, 25, 6);

    // Randomized tests
    for (t = 0; t < 20; t = t + 1) begin
      rand_matrix;
      rand_vector;
      n_iters = ($random % 4);
      if (n_iters < 0) n_iters = n_iters + 4;
      n_iters = n_iters + 1;
      
      run_markov_test(n_iters, ($random % 16), 100 + t);
    end

    // Summary
    $display("=====================================================");
    $display("Tests run:  %0d", tests_run);
    $display("Checks run: %0d", checks);
    $display("Errors:     %0d", errors);
    if (errors == 0)
      $display("RESULT: PASS");
    else
      $display("RESULT: FAIL");
    $display("=====================================================");

    $finish;
  end

  // Global safety-valve timeout
  initial begin
    #5000000;
    $display("ERROR: GLOBAL SIMULATION TIMEOUT");
    $finish;
  end

endmodule
